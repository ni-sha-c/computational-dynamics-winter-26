dup 52 /four put
dup 105 /i put
dup 109 /m put
dup 110 /n put
dup 111 /o put
dup 40 /parenleft put
dup 41 /parenright put
dup 43 /plus put
dup 115 /s put
dup 54 /six put
dup 51 /three put
dup 50 /two put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
